NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SMS OTP lewat Twilio (verifikasi nomor HP saat daftar). Isi "true" HANYA setelah Twilio
# dipasang di Supabase (Authentication → Sign In / Providers → Phone). Kalau kosong, daftar berjalan seperti biasa.
NEXT_PUBLIC_PHONE_OTP=false

# (Opsional) link chat WhatsApp owner untuk verifikasi akun baru. Default: https://wa.link/d57y1v
NEXT_PUBLIC_OWNER_WHATSAPP_URL=
