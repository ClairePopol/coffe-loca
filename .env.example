NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# (Opsional) link chat WhatsApp owner untuk verifikasi akun baru. Default: https://wa.link/d57y1v
NEXT_PUBLIC_OWNER_WHATSAPP_URL=

# Loca Store: WhatsApp number that receives orders, digits only with country code (e.g. 6281234567890).
# Leave empty to fall back to the owner's wa.link (the order message then has to be pasted manually).
NEXT_PUBLIC_STORE_WHATSAPP=
